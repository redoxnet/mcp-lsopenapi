<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>RedoxNet.Mcp.LsOpenApi</RootNamespace>
    <AssemblyName>redoxnet-mcp-lsopenapi</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>0.6.0</Version>
    <PackageId>RedoxNet.Mcp.LsOpenApi</PackageId>
	<Authors>Jong Hyun Kim</Authors>
    <Company>RedoxNet</Company>
    <Description>MCP server exposing LS증권 OpenAPI (REST) as tools. Read-only Korean stock market data and analysis via natural language.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/redoxnet/mcp-lsopenapi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/redoxnet/mcp-lsopenapi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;ai;dotnet;ls;ls-securities;ls-증권;korean-stock;openapi;stock</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 RedoxNet</Copyright>
    <PackageReleaseNotes>v0.6.0 (net +2 tools, 37 → 39): Market context (ls_get_index_quote via t1511 + ls_get_industry_indices via t8424+t1511 fanout with 60s cache + ls_get_industry_stocks via t1516), LS themes (ls_get_theme_stocks via t1537 with header continuation + ls_get_stock_themes via t1532), portfolio JSON export/import (schema v1, mode=merge/replace with before-import auto-backup), fire-and-forget t1532 theme enrichment with metadata_freshness hint, holdings_list theme_code/theme_keyword filters with matched_themes echo. BREAKING — Tier 1 compression (−5): ls_account_get + ls_account_set_default removed (use accounts_list[].is_default + upsert(set_default=true)), ls_holdings_split/_reverse_split/_bonus collapsed into ls_holdings_corporate_action(type, ratio) with open enum for v0.7+ extensions. BREAKING — watched_sectors → watched_themes rename (DB schema v3 migration preserves v0.5 data). v0.7 deferred: stocks.krx_sector enrichment and industry filter (confirmed t1102 lacks the field). See https://github.com/redoxnet/mcp-lsopenapi/blob/main/RELEASENOTES.Mcp.md for full notes.</PackageReleaseNotes>

    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-lsopenapi</ToolCommandName>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedoxNet.LsOpenApi.Core\RedoxNet.LsOpenApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP Apps (SEP-1865) UI resource served via resources/read. -->
    <EmbeddedResource Include="Apps\PlotlyTemplate.html" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RedoxNet.Mcp.LsOpenApi.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Sync check: .mcp/server.json's "version" fields must match csproj <Version>. -->
  <Target Name="VerifyServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json'))</_ServerJsonContent>
      <_ExpectedVersionToken>"version": "$(Version)"</_ExpectedVersionToken>
    </PropertyGroup>
    <Error Condition="!$(_ServerJsonContent.Contains($(_ExpectedVersionToken)))" Text=".mcp/server.json version is out of sync with csproj &lt;Version&gt;$(Version)&lt;/Version&gt;. Update both 'version' fields in .mcp/server.json to match before packing." />
  </Target>

</Project>

