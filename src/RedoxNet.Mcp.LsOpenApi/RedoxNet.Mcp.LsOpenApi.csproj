<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>RedoxNet.Mcp.LsOpenApi</RootNamespace>
    <AssemblyName>redoxnet-mcp-lsopenapi</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>0.8.0</Version>
    <PackageId>RedoxNet.Mcp.LsOpenApi</PackageId>
	<Authors>Jong Hyun Kim</Authors>
    <Company>RedoxNet</Company>
    <Description>MCP server exposing LS증권 OpenAPI (REST) as tools. Read-only Korean stock market data and analysis via natural language.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/redoxnet/mcp-lsopenapi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/redoxnet/mcp-lsopenapi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;ai;dotnet;ls;ls-securities;ls-증권;korean-stock;openapi;stock</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 RedoxNet</Copyright>
    <PackageReleaseNotes>v0.8.0 (net +5 tools, 43 → 48): Overseas market data + per-stock analytics. ls_get_global_market_quote (t3521 overseas index/FX/futures snapshot — nasdaq/sp500/dow/soxx/usdkrw/wti/gold aliases), ls_get_analyst_opinions (t3401 brokerage 투자의견/목표가 change history), ls_get_short_selling_trend (t1927 per-stock 공매도 daily trend), ls_get_market_funds_trend (t8428 고객예탁금/신용잔고/펀드자금 series), ls_get_high_low_stocks (t1442 신고/신저가 screener). Embedded TR catalog grows 33 → 45 (adds t3102/t3518/t3521 plus nine staged TRs reachable via ls_call_tr). ls_call_tr now surfaces body continuation cursors (continuation.keys) for TRs that page by tr_cont header yet also carry a body cursor field (e.g. t3401). The response-shape / token-economy refactor that the v0.8 line originally bundled has moved to v0.9. See https://github.com/redoxnet/mcp-lsopenapi/blob/main/RELEASENOTES.Mcp.md for full notes.</PackageReleaseNotes>

    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-lsopenapi</ToolCommandName>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedoxNet.LsOpenApi.Core\RedoxNet.LsOpenApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP Apps (SEP-1865) UI resource served via resources/read. -->
    <EmbeddedResource Include="Apps\PlotlyTemplate.html" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RedoxNet.Mcp.LsOpenApi.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Sync check: .mcp/server.json's "version" fields must match csproj <Version>. -->
  <Target Name="VerifyServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json'))</_ServerJsonContent>
      <_ExpectedVersionToken>"version": "$(Version)"</_ExpectedVersionToken>
    </PropertyGroup>
    <Error Condition="!$(_ServerJsonContent.Contains($(_ExpectedVersionToken)))" Text=".mcp/server.json version is out of sync with csproj &lt;Version&gt;$(Version)&lt;/Version&gt;. Update both 'version' fields in .mcp/server.json to match before packing." />
  </Target>

</Project>

