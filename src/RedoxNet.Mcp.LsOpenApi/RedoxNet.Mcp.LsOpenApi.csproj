<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>RedoxNet.Mcp.LsOpenApi</RootNamespace>
    <AssemblyName>redoxnet-mcp-lsopenapi</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>0.9.0</Version>
    <PackageId>RedoxNet.Mcp.LsOpenApi</PackageId>
	<Authors>Jong Hyun Kim</Authors>
    <Company>RedoxNet</Company>
    <Description>MCP server exposing LS증권 OpenAPI (REST) as tools. Read-only Korean stock market data and analysis via natural language.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/redoxnet/mcp-lsopenapi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/redoxnet/mcp-lsopenapi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;ai;dotnet;ls;ls-securities;ls-증권;korean-stock;openapi;stock</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 RedoxNet</Copyright>
    <PackageReleaseNotes>v0.9.0 (BREAKING — response-shape / token-economy refactor, Phase 1): Three high-traffic tools reshaped so the default call carries only what the common question needs and the heavy payload becomes opt-in. ls_get_index_history gains verbosity (summary | compact | full, default summary). ls_get_stock_info gains sections (default snapshot+fundamentals; response keys reorganized). ls_holdings_list gains themes_limit / include_industry / include_quote (per-holding themes is now a count/shown/items object). cl100k-measured default-call savings: 66–97%. Infra: ModelContextProtocol SDK 1.2.0 → 1.3.0; TargetFrameworks net8.0;net9.0 → net8.0;net10.0. See the Migration section in https://github.com/redoxnet/mcp-lsopenapi/blob/main/RELEASENOTES.Mcp.md for restoring the v0.8 shape.</PackageReleaseNotes>

    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mcp-lsopenapi</ToolCommandName>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    <PackageReference Include="Dapper" Version="2.1.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RedoxNet.LsOpenApi.Core\RedoxNet.LsOpenApi.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp\" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP Apps (SEP-1865) UI resource served via resources/read. -->
    <EmbeddedResource Include="Apps\PlotlyTemplate.html" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RedoxNet.Mcp.LsOpenApi.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Sync check: .mcp/server.json's "version" fields must match csproj <Version>. -->
  <Target Name="VerifyServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <_ServerJsonContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.mcp\server.json'))</_ServerJsonContent>
      <_ExpectedVersionToken>"version": "$(Version)"</_ExpectedVersionToken>
    </PropertyGroup>
    <Error Condition="!$(_ServerJsonContent.Contains($(_ExpectedVersionToken)))" Text=".mcp/server.json version is out of sync with csproj &lt;Version&gt;$(Version)&lt;/Version&gt;. Update both 'version' fields in .mcp/server.json to match before packing." />
  </Target>

</Project>

