{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.redoxnet/lsopenapi",
  "description": "LS Securities OpenAPI MCP server: Korean + overseas stocks, charts, screeners, portfolio.",
  "version": "1.4.0",
  "repository": {
    "url": "https://github.com/redoxnet/mcp-lsopenapi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org/v3/index.json",
      "identifier": "RedoxNet.Mcp.LsOpenApi",
      "version": "1.4.0",
      "runtimeHint": "dnx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LS_APPKEY",
          "value": "{ls_appkey}",
          "variables": {
            "ls_appkey": {
              "description": "LS Securities OpenAPI AppKey",
              "isRequired": true,
              "isSecret": true
            }
          }
        },
        {
          "name": "LS_APPSECRETKEY",
          "value": "{ls_appsecretkey}",
          "variables": {
            "ls_appsecretkey": {
              "description": "LS Securities OpenAPI AppSecretKey",
              "isRequired": true,
              "isSecret": true
            }
          }
        },
        {
          "name": "LS_MARKET",
          "value": "{ls_market}",
          "variables": {
            "ls_market": {
              "description": "LS OpenAPI environment: real or virtual",
              "isRequired": false,
              "default": "real",
              "choices": [
                "real",
                "virtual"
              ]
            }
          }
        }
      ]
    }
  ]
}
