<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RedoxNet.LsOpenApi.Core</RootNamespace>
    <AssemblyName>RedoxNet.LsOpenApi.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>0.8.0</Version>
    <PackageId>RedoxNet.LsOpenApi.Core</PackageId>
    <Authors>Jong Hyun Kim</Authors>
    <Company>RedoxNet</Company>
    <Description>SDK for LS증권 OpenAPI: HTTP client, OAuth2 client_credentials, TR catalog, indicators.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/redoxnet/mcp-lsopenapi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/redoxnet/mcp-lsopenapi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ls;ls-securities;ls-증권;openapi;korean-stock;stock;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) 2026 RedoxNet</Copyright>
    <PackageReleaseNotes>v0.8.0: Embedded TR catalog grows to 45 entries (was 33). Adds t3521 (해외지수조회) + t3518 (해외실시간지수) + t3102 (뉴스본문) under /stock/investinfo, plus nine staged TRs — t1105 (피봇/디마크), t1305 (기간별주가), t1403 (신규상장), t1442 (신고/신저가), t1475 (체결강도추이), t1927 (공매도일별추이), t3401 (투자의견), t8425 (전체테마), t8428 (증시주변자금). LsApiClient continuation now populates body cursor fields (LsTrResponse.ContinuationKeys) from the catalog's key_fields even for TRs that page by tr_cont header — pure body-paged and pure header-paged TRs are unaffected. Backs the Mcp package's v0.8 wrappers (ls_get_global_market_quote / ls_get_analyst_opinions / ls_get_short_selling_trend / ls_get_market_funds_trend / ls_get_high_low_stocks). Lockstep version bump with RedoxNet.Mcp.LsOpenApi 0.8.0. See https://github.com/redoxnet/mcp-lsopenapi/blob/main/RELEASENOTES.Core.md for full notes.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
    <PackageReference Include="Polly" Version="8.*" />
    <PackageReference Include="Skender.Stock.Indicators" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\TrCatalog.json" Condition="Exists('Catalog\TrCatalog.json')" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RedoxNet.LsOpenApi.Core.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Assembly name, not project name: the MCP server's <AssemblyName> is
         redoxnet-mcp-lsopenapi. Lets it use Core internals such as the
         Charting/ chart-spec builders. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>redoxnet-mcp-lsopenapi</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
